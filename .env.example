# ---------------------------------------------------------------------------
# ANTIGRAVITY PORTFOLIO CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your custom credentials.
# ---------------------------------------------------------------------------

# 1. Telegram Bot Integration
# Message @BotFather on Telegram to create a new bot and obtain the Bot Token.
# Message @GetIDsBot or @userinfobot to retrieve your personal Chat ID.
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Web3Forms Email Delivery Integration (Free, no backend required)
# Visit https://web3forms.com/, submit your email, and obtain your free Access Key.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
